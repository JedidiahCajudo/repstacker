<h1>Training Log</h1>

<%= link_to "Log a New Workout", new_workout_path %>

<div id="workouts">
  <% @workouts.each do |workout|  %>
    <div>
      <%= link_to workout.date.strftime("%B %d %y"), workout_path(workout.id) %>
      <% workout.exercises.each do |exercise|  %>
        <div>
          <%= exercise.name  %>
          <% exercise.working_sets.each do |set| %>
            <div><%= set.weight %>kg x <%= set.reps %></div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
